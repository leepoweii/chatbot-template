FLASK_SECRET_KEY=

# 指到你的知識庫資料夾（要有一份 CLAUDE.md 當索引）。
# 留空 = 用這個 repo 自己的根目錄（也就是這份 CLAUDE.md + data/）。
HARNESS_CWD=

# --- 只有要部署到區網／給別人連才需要碰下面這些（本機自己測試留空就好）---

# 預設只有這台機器自己連得到（127.0.0.1）。要讓同事連進來，改成 0.0.0.0。
HOST=127.0.0.1
PORT=5050

# HOST 一旦不是 127.0.0.1，就是開放給整個網段——這時候「二選一」：
# ① 設這個密碼（推薦，帳號固定是 welly）
BASIC_AUTH_PASSWORD=
# ② 或者你很確定這個網路安全、不想設密碼，明確承認風險：
ALLOW_INSECURE_LAN=
